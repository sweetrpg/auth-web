# Required terms version and whether publishing it forces existing users to re-accept.
# Unset REQUIRED_TERMS_VERSION leaves the terms-acceptance gate with nothing to enforce.
REQUIRED_TERMS_VERSION=1.0
TERMS_VERSION_MATERIAL=false

# flagd sidecar OFREP endpoint (feature flag terms-acceptance-gate, default off).
FLAGD_OFREP_URL=http://localhost:8016

USERS_API_URL=http://localhost:8001
